# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
# Leave unset to disable analytics — the layout will not render the gtag script.
NEXT_PUBLIC_GA_ID=

# Google AdSense publisher ID (e.g. ca-pub-1234567890123456)
# Leave unset to disable ads — no ad script or slots will render until this is set.
NEXT_PUBLIC_ADSENSE_ID=

# Search-engine site-ownership verification codes (paste the code each console gives you).
# Each renders a <meta> verification tag only when set; unset = no tag.
# Bing Webmaster Tools — the "meta tag" option gives content="XXXX" for name="msvalidate.01"
NEXT_PUBLIC_BING_VERIFICATION=
# Yandex Webmaster — the "Meta tag" option gives content="XXXX" for name="yandex-verification"
NEXT_PUBLIC_YANDEX_VERIFICATION=
# Google Search Console — only needed if NOT already verified via DNS/domain property
NEXT_PUBLIC_GOOGLE_VERIFICATION=
